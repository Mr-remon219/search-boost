+#!/usr/bin/env node
+// Hermetic V2 resource/logic checks. These are NOT web-quality experiments.
+import assert from 'node:assert/strict'
+import {createHash} from 'node:crypto'
+import {runAdaptiveLoop} from '../lib/search/adaptive/loop.mjs'
+import {ADAPTIVE_LIMITS} from '../lib/search/adaptive/limits.js'
