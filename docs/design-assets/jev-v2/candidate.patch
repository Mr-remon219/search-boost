index 0000000000000000000000000000000000000000..4c8ac3dd85bdbd3edb51b9213cc4125ade2b8d65
--- /dev/null
+++ b/lib/search/adaptive/keyword-progress.js
@@ -0,0 +1,72 @@
+// Evidence readiness index, NOT a calibrated probability or a completeness proof.
+// Chosen by a two-stage development comparison; a final material-gap check is
+// mandatory. Recompute from current text versions; elapsed rounds earn no credit.
+const clamp = (value) => Number.isFinite(value) ? Math.max(0, Math.min(0.999, value)) : 0
+
+export function shingles(text) {
+  const normalized = String(text ?? '').toLowerCase().replace(/[^\p{L}\p{N}]/gu, '')
+  return new Set(Array.from({ length: Math.max(0, normalized.length - 4) }, (_, i) => normalized.slice(i, i + 5)))
+}
+
+/** Containment similarity. Conservative: a superset can be treated as duplicate.
+ * This is a textual heuristic, not semantic equivalence or a provenance proof. */
+export function similarity(a, b) {
+  if (!a.size || !b.size) return 0
+  let overlap = 0
+  for (const part of a) if (b.has(part)) overlap++
+  return overlap / Math.min(a.size, b.size)
+}
+
+/** Conservative site bucket; not a public-suffix parser or proof of independence.
+ * e.g. co.uk and github.io authors may be over-grouped rather than over-counted. */
+export function sourceGroup(url) {
+  try { return new URL(url).hostname.replace(/^www\./, '').split('.').slice(-2).join('.') }
+  catch { return 'unknown' }
+}
+
+/**
+ * q_i = min(relevance, evidence) * (0.5 + 0.5 * sufficiency)
+ * delta_i = [-log(1-q_i) / -log(1-tau)] * (1/i) * (1/(1+sameSite)) * novelty
+ * S = sum(delta_i); S > 1 means ready for final check, never directly covered.
+ * i counts nonduplicate qualified fragments, ranked by q, NOT search attempts.
+ */
+export function scoreEvidence(rows, { gate = 0.60, tau = 0.60 } = {}) {
+  const eligible = rows.filter(({ judgment: j }) =>
+    ['relevant', 'states_evidence', 'injection', 'sufficient'].every((key) => Number.isFinite(j?.[key]))
+    && j.relevant > gate && j.states_evidence > gate && j.injection <= 0.7)
+  const strength = ({ judgment: j }) => Math.min(clamp(j.relevant), clamp(j.states_evidence)) * (0.5 + 0.5 * clamp(j.sufficient))
+  eligible.sort((a, b) => strength(b) - strength(a) || String(a.evidenceId).localeCompare(String(b.evidenceId)))
+  const prior = [], domains = new Map(), contributions = []
+  let score = 0, distinct = 0
+  for (const item of eligible) {
+    const set = shingles(item.text)
+    const overlap = prior.reduce((largest, previous) => Math.max(largest, similarity(set, previous)), 0)
+    if (overlap >= 0.8) {
+      contributions.push({ id: item.evidenceId, delta: 0, reason: 'duplicate' })
+      continue
+    }
+    distinct++
+    const group = sourceGroup(item.url)
+    const sameSite = domains.get(group) ?? 0
+    const independence = 1 / (1 + sameSite)
+    const novelty = 1 - overlap
+    const quality = strength(item)
+    const positionWeight = 1 / distinct
+    const delta = (-Math.log1p(-quality) / -Math.log1p(-tau)) * positionWeight * independence * novelty
+    score += delta
+    contributions.push({ id: item.evidenceId, delta, quality, novelty, independence, positionWeight })
+    prior.push(set)
+    domains.set(group, sameSite + 1)
+  }
+  return { score, ready: score > 1, eligible: eligible.length, distinct, contributions }
+}
+
+/** Global next-round quota. Zero remaining means final check, never more search. */
+export function nextPoolLimit(remaining, total, { maxPoolRowsPerRound = 500, recoveryConstant = 1.25, minPoolRowsPerRound = 24 } = {}) {
+  if (!Number.isInteger(total) || total < 1 || !Number.isInteger(remaining) || remaining < 0 || remaining > total) throw new Error('Invalid keyword counts')
+  return remaining === 0 ? 0 : Math.min(maxPoolRowsPerRound, Math.max(minPoolRowsPerRound, Math.ceil(maxPoolRowsPerRound * recoveryConstant * remaining / total)))
+}
+
+export function keywordList(question) {
+  return question.keywords?.length ? question.keywords : [question.acceptance ?? question.text]
+}
