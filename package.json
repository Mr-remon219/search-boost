{
  "name": "search-boost",
  "version": "0.2.0",
  "description": "Multi-engine web search for coding agents — one SearchBoost core (fused search, fetch, X) with MCP (Cursor, Codex, Claude Code, Grok Build, Antigravity), pi extension, and DeepSeek Harness bundle adapters",
  "type": "module",
  "bin": {
    "search-boost": "./cli.mjs"
  },
  "main": "./cli.mjs",
  "exports": {
    ".": "./cli.mjs",
    "./pi": "./adapters/pi/index.js",
    "./dsh": "./adapters/dsh/index.js",
    "./adapters/*": "./adapters/*",
    "./lib/*": "./lib/*",
    "./agents/*": "./agents/*",
    "./package.json": "./package.json"
  },
  "pi": {
    "extensions": [
      "./adapters/pi/index.js"
    ]
  },
  "dsh": {
    "bundle": {
      "patch": "./adapters/dsh/cordis.patch.yml"
    }
  },
  "files": [
    "cli.mjs",
    "migrate.mjs",
    "server.mjs",
    "lib/",
    "adapters/",
    "agents/",
    "grok-plugin/",
    "templates/",
    "docs/",
    "README.md",
    "README_zh.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node cli.mjs serve",
    "install:agents": "node cli.mjs install",
    "smoke": "node scripts/smoke.mjs",
    "test:install": "node scripts/test-install.mjs && node scripts/test-startup-hooks.mjs && node scripts/test-skill-bundles.mjs",
    "test:skills": "node scripts/test-skill-bundles.mjs",
    "test:mcp": "node scripts/test-mcp-guidance.mjs",
    "test:parallel": "node scripts/test-parallel-research.mjs",
    "test:upgrade": "node scripts/test-upgrade.mjs && node scripts/test-host-upgrade.mjs && node scripts/test-migration.mjs && node scripts/test-update-tui.mjs",
    "test:hooks": "node scripts/test-startup-hooks.mjs",
    "test:doctor": "node scripts/test-doctor.mjs",
    "test:adapters": "node scripts/test-adapters.mjs",
    "plugin:sync-grok": "node scripts/sync-grok-plugin.mjs",
    "build:plugin": "node scripts/build-plugin.mjs",
    "check": "node scripts/check-syntax.mjs",
    "test:fusion": "node scripts/test-fusion-errors.mjs",
    "test:x": "node scripts/test-x-pipeline.mjs",
    "test:engines": "node scripts/test-engine-requests.mjs",
    "test:xauth": "node scripts/test-xauth.mjs",
    "test:jev": "node scripts/test-jev.mjs",
    "test:jev-client": "node scripts/test-jev-client.mjs",
    "test:adaptive": "node scripts/test-adaptive-search.mjs",
    "jev:probe": "node scripts/jev-probe.mjs",
    "eval:adaptive": "node scripts/eval-adaptive-search.mjs",
    "test:cli": "node scripts/test-cli-surface.mjs",
    "prepublishOnly": "npm run plugin:sync-grok && npm run check && npm run test:cli && npm run test:install && npm run test:doctor && npm run test:fusion && npm run test:x && npm run test:engines && npm run test:xauth && npm run test:jev && npm run test:keys-authority && npm run test:dry-run && npm run test:network && npm run test:jev-client && npm run test:adaptive && npm run test:search && npm run test:adapters && npm run test:parallel && npm run test:upgrade && npm run test:mcp && npm run smoke",
    "test:search": "node scripts/test-search-routing.mjs",
    "test:keys-authority": "node scripts/test-keys-authority.mjs",
    "test:dry-run": "node scripts/test-dry-run.mjs",
    "test:network": "node scripts/test-network-safety.mjs && node scripts/test-audit-regressions.mjs"
  },
  "dependencies": {
    "@clack/prompts": "^0.10.1",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "undici": "^6.27.0",
    "zod": "^3.24.2"
  },
  "engines": {
    "node": ">=22.13"
  },
  "keywords": [
    "mcp",
    "cursor",
    "codex",
    "claude-code",
    "grok",
    "antigravity",
    "pi-package",
    "dsh-plugin",
    "deepseek-harness",
    "web-search",
    "x-search",
    "search-boost",
    "pi",
    "pi-coding-agent",
    "pi-extension",
    "dsh",
    "deepseek"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mr-remon219/search-boost.git"
  },
  "bugs": {
    "url": "https://github.com/Mr-remon219/search-boost/issues"
  },
  "homepage": "https://github.com/Mr-remon219/search-boost#readme"
}
