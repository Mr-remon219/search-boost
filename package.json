{
  "name": "search-boost-mcp",
  "version": "0.1.6",
  "description": "Multi-engine web search MCP for Cursor, Codex, Claude Code, Grok Build, and Antigravity — fused search, fetch, X, deep research",
  "type": "module",
  "bin": {
    "search-boost": "./cli.mjs",
    "search-boost-mcp": "./cli.mjs"
  },
  "main": "./cli.mjs",
  "files": [
    "cli.mjs",
    "server.mjs",
    "lib/",
    "tools/",
    "agents/",
    "grok-plugin/",
    "templates/",
    "README.md",
    "README_zh.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node cli.mjs serve",
    "install:agents": "node cli.mjs install",
    "smoke": "node scripts/smoke.mjs",
    "test:install": "node scripts/test-install.mjs",
    "test:doctor": "node scripts/test-doctor.mjs",
    "plugin:sync-grok": "node scripts/sync-grok-plugin.mjs",
    "build:plugin": "node scripts/build-plugin.mjs",
    "check": "node scripts/check-syntax.mjs",
    "test:fusion": "node scripts/test-fusion-errors.mjs",
    "prepublishOnly": "npm run plugin:sync-grok && npm run check && npm run test:install && npm run test:doctor && npm run test:fusion && npm run smoke"
  },
  "dependencies": {
    "@clack/prompts": "^0.10.1",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "undici": "^6.27.0",
    "zod": "^3.24.2"
  },
  "engines": {
    "node": ">=22.13"
  },
  "keywords": [
    "mcp",
    "cursor",
    "codex",
    "claude-code",
    "grok",
    "antigravity",
    "web-search",
    "search-boost"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mr-remon219/search-boost.git"
  },
  "bugs": {
    "url": "https://github.com/Mr-remon219/search-boost/issues"
  },
  "homepage": "https://github.com/Mr-remon219/search-boost#readme"
}
